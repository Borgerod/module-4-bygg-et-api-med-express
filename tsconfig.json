{
	"compilerOptions": {
		"target": "ES2017",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"strict": true,
		"noEmit": true,
		"module": "esnext",
		// "moduleResolution": "bundler",
		// "esModuleInterop": true,
		// "skipLibCheck": true,
		"moduleResolution": "node",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"forceConsistentCasingInFileNames": true,
		"plugins": [
			{
				"name": "next"
			}
		],

		"paths": {
			"@types": ["./src/lib/types.ts"],
			"@lib/*": ["./src/lib/*"],
			"@/*": ["./src/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		"**/*.mts"
	],
	"exclude": ["node_modules"]
}
